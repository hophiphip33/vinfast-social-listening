# Sử dụng Python 3.9 (như file gốc của bạn) hoặc 3.10
FROM python:3.9-slim

WORKDIR /app

# [SỬA] Thêm ffmpeg (cần cho yt-dlp), bỏ chromium (nếu không dùng Selenium)
# Giúp giảm dung lượng image và tăng tốc build trên Render
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt thư viện Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Tải dữ liệu NLTK (Tokenizer)
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('stopwords')"

# Tải trước model PhoBERT để "đóng gói" vào Image
# [LƯU Ý]: Nếu Render bị lỗi "Out of Memory" khi build, hãy XÓA dòng RUN này
# và để code tự tải model khi chạy lần đầu.
RUN python -c "from transformers import AutoTokenizer, AutoModelForSequenceClassification; \
    AutoTokenizer.from_pretrained('wonrax/phobert-base-vietnamese-sentiment'); \
    AutoModelForSequenceClassification.from_pretrained('wonrax/phobert-base-vietnamese-sentiment')"

# Tạo các thư mục cần thiết
RUN mkdir -p /app/logs /app/ml-models /app/data

# Copy code vào image
COPY backend/ ./backend/
# COPY config/ ./config/  <-- Bỏ dòng này nếu thư mục config không nằm ở root
# (Theo code của bạn, settings nằm trong backend/config/settings.py nên dòng trên copy backend/ là đủ)

# Thiết lập biến môi trường
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Tạo user non-root để chạy cho an toàn (Best practice)
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# Lệnh chạy server (Render sẽ dùng lệnh này)
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]