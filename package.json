{
  "name": "vinfast-social-listening",
  "version": "1.0.0",
  "description": "VinFast Social Listening Platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && python -m uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
    "frontend": "vite frontend/admin_app",
    "install-all": "npm install && pip install -r requirements.txt",
    "build": "vite build",
    "preview": "vite preview",
    "test": "cd backend && pytest",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^2.0.0"
  }
}
