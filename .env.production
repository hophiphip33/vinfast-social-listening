# Production Environment Variables
# Copy this to .env.prod and fill in your production values

# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-mongodb-password-here
MONGODB_URL=mongodb://admin:your-secure-mongodb-password-here@mongodb:27017/vinfast_social_listening?authSource=admin
DATABASE_NAME=vinfast_social_listening

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password-here
REDIS_URL=redis://:your-secure-redis-password-here@redis:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-very-long-secure-secret-key-change-this-in-production

# Frontend Configuration
FRONTEND_API_URL=https://your-domain.com
REACT_APP_API_URL=https://your-domain.com

# Docker Registry
DOCKER_REGISTRY=your-registry.com
IMAGE_TAG=latest

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Monitoring
GRAFANA_PASSWORD=your-grafana-password
PROMETHEUS_RETENTION=30d

# Data Collection (Production limits)
NEWS_CRAWL_DELAY=5
SOCIAL_CRAWL_DELAY=10
MAX_POSTS_PER_BATCH=50

# Logging
LOG_LEVEL=WARNING
LOG_FILE=logs/production.log

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# Security
ALLOWED_HOSTS=your-domain.com,localhost
CORS_ORIGINS=https://your-domain.com,http://localhost:3000

# Performance
MAX_WORKERS=4
WORKER_TIMEOUT=120
KEEP_ALIVE_TIMEOUT=5
